flowchart TB
    classDef cicd fill:#0f172a,stroke:#38bdf8,color:#f8fafc,stroke-width:3px
    classDef registry fill:#fff7ed,stroke:#f97316,color:#7c2d12,stroke-width:3px
    classDef staging fill:#eff6ff,stroke:#3b82f6,color:#1e3a8a,stroke-width:3px
    classDef production fill:#f0fdf4,stroke:#22c55e,color:#14532d,stroke-width:3px
    classDef network fill:#f5f3ff,stroke:#8b5cf6,color:#4c1d95,stroke-width:3px
    classDef edge fill:#ecfeff,stroke:#06b6d4,color:#164e63,stroke-width:3px
    classDef monitor fill:#fff1f2,stroke:#f43f5e,color:#881337,stroke-width:3px
    classDef note fill:#f8fafc,stroke:#94a3b8,color:#334155,stroke-width:2px

    I[(Internet)]:::edge
    H["Amazon CloudFront<br/><b>HTTPS / TLS</b><br/>Origin Header Protection"]:::edge
    F["Application Load Balancer<br/><b>Path-based Routing</b><br/>Public entry · Private targets"]:::network

    subgraph ENV["ECS Fargate · Isolated Environments"]
        direction TB
        D["STAGING<br/><b>devops-app-staging</b><br/>/devops/staging/status"]:::staging
        G{{"Health-check passed<br/><b>Manual approval</b><br/>GitHub Environment: production"}}:::note
        E["PRODUCTION<br/><b>devops-app-production</b><br/>/devops/production/status"]:::production
    end

    C["Amazon ECR<br/><b>Immutable image tag</b><br/>Commit SHA"]:::registry
    B["AWS IAM Role<br/><b>OIDC</b><br/>Temporary credentials"]:::cicd
    A["GitHub Actions<br/><b>Build · Smoke Test · Deploy</b>"]:::cicd

    J["CloudWatch Alarms<br/><b>UnHealthyHostCount</b>"]:::monitor
    K["Amazon SNS<br/><b>Confirmed e-mail subscription</b>"]:::monitor

    I -->|HTTPS request| H
    H -->|Origin verification header| F
    F -->|/devops/staging/*| D
    F -->|/devops/production/*| E

    A -->|Assume role| B
    B -->|Build and publish| C
    C -->|Deploy image| D
    D -->|Promote the same image| G
    G --> E

    F -.->|Health metrics| J
    J -->|State change| K

    style ENV fill:#f8fafc,stroke:#64748b,stroke-width:3px
    linkStyle 0,1,2,3 stroke:#7c3aed,stroke-width:3px
    linkStyle 4,5,6,7,8 stroke:#2563eb,stroke-width:3px
    linkStyle 9,10 stroke:#e11d48,stroke-width:3px
