flowchart LR
    A[Push na branch main] --> B[GitHub Actions]
    B --> C[OIDC]
    C --> D[Role app-deploy]
    D --> E[npm ci]
    E --> F[Lint e testes]
    F --> G[Docker build]
    G --> H[Trivy image]
    H --> I[Smoke test]
    I --> J{SHA já existe no ECR?}
    J -- Não --> K[Push da imagem imutável]
    J -- Sim --> L[Reutilizar imagem]
    K --> M[Deploy staging]
    L --> M
    M --> N[Health-check staging]
    N --> O{Aprovação production}
    O --> P[Mesma SHA em production]
    P --> Q[Health-check production]

    classDef action fill:#0f172a,stroke:#38bdf8,color:#f8fafc,stroke-width:2px
    classDef security fill:#f0fdf4,stroke:#22c55e,color:#14532d,stroke-width:2px
    classDef validation fill:#fff7ed,stroke:#f97316,color:#7c2d12,stroke-width:2px
    classDef decision fill:#f5f3ff,stroke:#8b5cf6,color:#4c1d95,stroke-width:2px
    class A,B,E,F,G,M,P action
    class C,D security
    class H,I,N,Q validation
    class J,O decision
